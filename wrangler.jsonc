{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  // Production (main branch) — kayalevents.bobinthomas.workers.dev → kayalevents.com.au at cutover
  "name": "kayalevents",
  "compatibility_date": "2026-06-13",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "observability": { "enabled": true },
  "vars": {
    "NEXT_PUBLIC_KEYSTATIC_GITHUB_CLIENT_ID": "Ov23likSh8xSq5c6hudN"
  },
  // Staging (dev branch) — separate Worker + separate GitHub OAuth App (OAuth apps allow only ONE callback URL).
  // Create a second OAuth app with callback:
  //   https://kayalevents-dev.bobinthomas.workers.dev/api/keystatic/github/oauth/callback
  // Then set NEXT_PUBLIC_KEYSTATIC_GITHUB_CLIENT_ID below and run npm run setup:staging-secrets
  "env": {
    "staging": {
      "name": "kayalevents-dev",
      "vars": {
        "NEXT_PUBLIC_KEYSTATIC_GITHUB_CLIENT_ID": "Ov23liexJotSlY5iTU3z",
        "KEYSTATIC_GITHUB_REF": "dev"
      }
    },
    // Dance team performer registration (dancers.kayalevents.com.au) — deployed from
    // the `dancers` branch, which rewrites "/" to the registration form (mirrors how
    // the `dev` branch rewrites "/" to /dancer-eoi for eoi.kayalevents.com.au).
    // Reuses production's Keystatic OAuth app client ID — /keystatic on this Worker
    // isn't meant to be used, so a mismatched OAuth callback here is not a concern.
    "dancers": {
      "name": "kayalevents-dancers",
      "vars": {
        "NEXT_PUBLIC_KEYSTATIC_GITHUB_CLIENT_ID": "Ov23likSh8xSq5c6hudN"
      }
    }
  }
  // Production OAuth app callback (keep on your existing app — do not change for staging):
  //   https://kayalevents.bobinthomas.workers.dev/api/keystatic/github/oauth/callback
  // Secrets (set per environment — production vs staging):
  //   wrangler secret put KEYSTATIC_GITHUB_CLIENT_SECRET
  //   wrangler secret put KEYSTATIC_SECRET
  //   wrangler secret put KEYSTATIC_GITHUB_TOKEN
  // /keystatic username/password sign-in (alternative to GitHub OAuth):
  //   wrangler secret put ADMIN_USERNAME
  //   wrangler secret put ADMIN_PASSWORD
  //   wrangler secret put KEYSTATIC_BOT_TOKEN     # fine-grained PAT, Contents: Read and write
  // Staging copies:
  //   wrangler secret put KEYSTATIC_GITHUB_CLIENT_SECRET --env staging
  //   wrangler secret put KEYSTATIC_SECRET --env staging
  //   wrangler secret put KEYSTATIC_GITHUB_TOKEN --env staging
  //   wrangler secret put ADMIN_USERNAME --env staging
  //   wrangler secret put ADMIN_PASSWORD --env staging
  //   wrangler secret put KEYSTATIC_BOT_TOKEN --env staging
  // Dancers copies (plus DANCE_TEAM_APPS_SCRIPT_URL and, if reused, TURNSTILE_SECRET):
  //   wrangler secret put KEYSTATIC_GITHUB_CLIENT_SECRET --env dancers
  //   wrangler secret put KEYSTATIC_SECRET --env dancers
  //   wrangler secret put KEYSTATIC_GITHUB_TOKEN --env dancers
  //   wrangler secret put DANCE_TEAM_APPS_SCRIPT_URL --env dancers
}
