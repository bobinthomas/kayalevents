# --- Sanity CMS (R3) ---
# Create a project at sanity.io, then set these. Until configured, the site
# serves placeholder seed content and /studio shows setup instructions.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Webhook secret for on-demand revalidation (Sanity webhook -> POST /api/revalidate?secret=...)
REVALIDATE_SECRET=

# --- Analytics (R9) ---
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# --- Kayal Insider email capture (R5) — Brevo ---
BREVO_API_KEY=
BREVO_LIST_ID=

# --- Inquiry email delivery (R6) — Resend ---
RESEND_API_KEY=
INQUIRY_EMAIL=kayaleventsofficial@gmail.com
INQUIRY_FROM=Kayal Events <inquiries@kayalevents.com.au>
