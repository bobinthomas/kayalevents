# --- Keystatic CMS ---
# Production defaults to GitHub storage (see keystatic.config.ts).
# For local-only editing without GitHub, set both:
#   KEYSTATIC_STORAGE=local
#   NEXT_PUBLIC_KEYSTATIC_STORAGE=local
# 1. Create a GitHub OAuth App at github.com/settings/developers
# 2. Callback URLs — classic GitHub OAuth Apps allow **one URL per app**. Use separate apps:
#    Production app:
#      https://kayalevents.bobinthomas.workers.dev/api/keystatic/github/oauth/callback
#    Staging app (second OAuth app — see README):
#      https://kayalevents-dev.bobinthomas.workers.dev/api/keystatic/github/oauth/callback
#    Local dev (production or staging app, or a third app):
#      http://127.0.0.1:3000/api/keystatic/github/oauth/callback
# 3. Generate a random KEYSTATIC_SECRET (e.g. openssl rand -base64 32)
# 4. Create a read-only GitHub PAT (repo Contents: Read) for the site reader on Workers
KEYSTATIC_STORAGE=
NEXT_PUBLIC_KEYSTATIC_STORAGE=
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
KEYSTATIC_GITHUB_TOKEN=                    # read-only PAT — required for live site content reader
NEXT_PUBLIC_KEYSTATIC_GITHUB_CLIENT_ID=   # same as KEYSTATIC_GITHUB_CLIENT_ID (public, baked at build)

# --- Sanity CMS (legacy, no longer used) ---
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
REVALIDATE_SECRET=

# --- Analytics (R9) ---
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# --- Kayal Insider email capture (R5) — Brevo ---
BREVO_API_KEY=
BREVO_LIST_ID=

# --- Inquiry email delivery (R6) — Resend ---
RESEND_API_KEY=
INQUIRY_EMAIL=kayaleventsofficial@gmail.com
INQUIRY_FROM=Kayal Events <inquiries@kayalevents.com.au>

# --- Dancer EOI Intake System ---
# 1. Deploy apps-script/dancer-eoi/ as a Google Apps Script web app (Execute as: Me, Access: Anyone with Google account).
# 2. Paste the deployment URL below (server-only — no NEXT_PUBLIC_ prefix needed).
EOI_APPS_SCRIPT_URL=                     # Apps Script web app URL
# 3. Create a Cloudflare Turnstile widget at dash.cloudflare.com → Turnstile.
#    Site key is public (baked into the browser bundle).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=          # Turnstile site key
#    Secret key is server-only — verified in /api/eoi/submit.
TURNSTILE_SECRET=                        # Turnstile secret key

# --- #KayalReelFest Reel Contest Intake ---
# 1. Deploy apps-script/reel-contest/ as a Google Apps Script web app (Execute as: Me, Access: Anyone).
# 2. Paste the deployment URL below (server-only — no NEXT_PUBLIC_ prefix needed).
REEL_CONTEST_APPS_SCRIPT_URL=             https://script.google.com/macros/s/AKfycbyn2p_fMx2SXug52PP1rheB778RSk9RP3RzqwUEG8QjmMRBx1wdTl8Bw_PfSiIZ2Lz9jw/exec
#    Reuses the same NEXT_PUBLIC_TURNSTILE_SITE_KEY / TURNSTILE_SECRET above — same hostname.

# --- Dance Team Performer Registration (dancers.kayalevents.com.au) ---
# 1. Deploy apps-script/dance-team-registration/ as a Google Apps Script web app (Execute as: Me, Access: Anyone).
# 2. Paste the deployment URL below (server-only — no NEXT_PUBLIC_ prefix needed).
DANCE_TEAM_APPS_SCRIPT_URL=               # Apps Script web app URL
#    Reuses the same NEXT_PUBLIC_TURNSTILE_SITE_KEY / TURNSTILE_SECRET above ONLY if that
#    Turnstile widget's allowed hostnames (Cloudflare dashboard) include dancers.kayalevents.com.au —
#    otherwise create a separate widget for this subdomain and set its own site/secret keys.
