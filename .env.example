# --- Keystatic CMS ---
# Production defaults to GitHub storage (see keystatic.config.ts).
# For local-only editing without GitHub, set: KEYSTATIC_STORAGE=local
# 1. Create a GitHub OAuth App at github.com/settings/developers
# 2. Callback URLs (add both):
#    - https://kayalevents.bobinthomas.workers.dev/api/keystatic/github/oauth/callback
#    - http://127.0.0.1:3000/api/keystatic/github/oauth/callback
# 3. Generate a random KEYSTATIC_SECRET (e.g. openssl rand -base64 32)
# 4. Create a read-only GitHub PAT (repo Contents: Read) for the site reader on Workers
KEYSTATIC_STORAGE=
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
KEYSTATIC_GITHUB_TOKEN=                    # read-only PAT — required for live site content reader
NEXT_PUBLIC_KEYSTATIC_GITHUB_CLIENT_ID=   # same as KEYSTATIC_GITHUB_CLIENT_ID (public, baked at build)

# --- Sanity CMS (legacy, no longer used) ---
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
REVALIDATE_SECRET=

# --- Analytics (R9) ---
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# --- Kayal Insider email capture (R5) — Brevo ---
BREVO_API_KEY=
BREVO_LIST_ID=

# --- Inquiry email delivery (R6) — Resend ---
RESEND_API_KEY=
INQUIRY_EMAIL=kayaleventsofficial@gmail.com
INQUIRY_FROM=Kayal Events <inquiries@kayalevents.com.au>
