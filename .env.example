# --- Keystatic CMS (GitHub storage, production only) ---
# 1. Create a GitHub OAuth App at github.com/settings/developers
# 2. Callback URL: https://<your-domain>/api/keystatic/github/oauth/callback
# 3. Generate a random KEYSTATIC_SECRET (e.g. openssl rand -base64 32)
# 4. Create a read-only GitHub PAT (repo scope) for the site reader on Cloudflare Workers
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
KEYSTATIC_GITHUB_TOKEN=                    # read-only PAT — required for live site + local dev with GitHub CMS
NEXT_PUBLIC_KEYSTATIC_GITHUB_CLIENT_ID=   # same value as KEYSTATIC_GITHUB_CLIENT_ID — enables GitHub mode in browser

# --- Sanity CMS (legacy, no longer used) ---
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
REVALIDATE_SECRET=

# --- Analytics (R9) ---
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# --- Kayal Insider email capture (R5) — Brevo ---
BREVO_API_KEY=
BREVO_LIST_ID=

# --- Inquiry email delivery (R6) — Resend ---
RESEND_API_KEY=
INQUIRY_EMAIL=kayaleventsofficial@gmail.com
INQUIRY_FROM=Kayal Events <inquiries@kayalevents.com.au>
